# 平台运行需要 Node.js 24+。此文件复制为 .env，不要提交实际密钥。
FLOW_HOST=127.0.0.1
FLOW_PORT=3210

# 推荐生产环境填写绝对路径，例如 /srv/flow-lite/data。
FLOW_DATA_DIR=./data

# 以下仅控制 Node.js 构建；PHP / 命令任务直接使用目标机已有环境。
# docker 是默认构建方式；host 仅用于可信仓库的本地调试。
FLOW_RUNNER_MODE=docker
# 镜像仓库前缀，不包含标签；默认使用 Docker Hub 的官方 node 镜像。
FLOW_NODE_IMAGE_PREFIX=node
# Docker Hub 无法访问时，可改为 AWS ECR 上的 Docker 官方镜像仓库：
# FLOW_NODE_IMAGE_PREFIX=public.ecr.aws/docker/library/node
FLOW_DOCKER_MEMORY=8g
FLOW_DOCKER_CPUS=4
FLOW_ALLOW_HOST_RUNNER=false
FLOW_ALLOW_LOCAL_REPOSITORIES=false

# 本地 HTTP 开发设为 false；生产 HTTPS 反向代理后改为 true。
FLOW_SECURE_COOKIE=false

# 首次创建管理员需要。留空时自动生成并写入 data/setup-token。
# FLOW_SETUP_TOKEN=替换为你自己生成的长随机字符串
